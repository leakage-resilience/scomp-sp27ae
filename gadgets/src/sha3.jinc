fn shake128(
    reg ptr SHAKE128_Output output,
    reg u32 txt,
    reg u32 len
) -> reg ptr SHAKE128_Output
{
    output = output;
    txt = txt;
    len = len;
    stack At state;
    reg ptr At statep;
    #[spill] reg u32 i j n_val at_inner out_inner s;

    statep = state;
    statep = keccak(42, 0x1F, statep, txt, len);

    n_val = N;
    i = 0;
    while (i < 8) {
        at_inner = i;
        at_inner ^= 1;
        at_inner *= n_val;
        out_inner = i;
        out_inner *= n_val;
        j = 0;
        while (j < N) {
            s = statep[at_inner];
            output[out_inner] = s;
            at_inner += 1;
            out_inner += 1;
            j += 1;
        }
        i += 1;
    }
    return output;
}

fn shake256(
    reg ptr SHAKE256_Output output,
    reg u32 txt,
    reg u32 len
) -> reg ptr SHAKE256_Output
{
    output = output;
    txt = txt;
    len = len;
    stack At state;
    reg ptr At statep;
    #[spill] reg u32 i j n_val at_inner out_inner s;

    statep = state;
    statep = keccak(34, 0x1F, statep, txt, len);

    n_val = N;
    i = 0;
    while (i < 16) {
        at_inner = i;
        at_inner ^= 1;
        at_inner *= n_val;
        out_inner = i;
        out_inner *= n_val;
        j = 0;
        while (j < N) {
            s = statep[at_inner];
            output[out_inner] = s;
            at_inner += 1;
            out_inner += 1;
            j += 1;
        }
        i += 1;
    }
    return output;
}
