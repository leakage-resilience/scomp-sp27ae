annotate lm_shr
    region mem w32 x[0:$ORDER]
    region mem w32 y[0:$ORDER]
    region mem w32 stack[-1024:0]

    init sp [stack 0]
    init a0 [y 0]
    init a1 [x 0]
    init ra exit

    input public a2
    input public a3
    input public a4
    input public a5
    input public a6
    input public a7
    input public x3
    input public x4

