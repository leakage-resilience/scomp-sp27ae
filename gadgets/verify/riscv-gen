    input public a4
    input public a5
    input public a6
    input public a7
    input public x3
    input public x4

    input sharing x
    output sharing x
    ;

annotate lm_shl
    region mem w32 x[0:$ORDER]
    region mem w32 y[0:$ORDER]
    region mem w32 stack[-1024:0]

