require import AllCore IntDiv Distr CoreMap List.
from Jasmin require import JArray JModel_m4.
require Masking.

prover ["Z3"].
timeout 1.

op order : { int | 0 <= order } as ge0_order'.
clone import PolyArray as ArrayN with op size <- order + 1.

op RandAndSize: int = (order + 1) * order %/ 2.

clone import PolyArray as ArrayPN with op size <- order.
clone import PolyArray as ArrayRandAnd with op size <- RandAndSize.


clone include Masking with
  op order <- order,
  theory P <- ArrayN
  proof ge0_order by exact ge0_order', *.


module MSpec = {
  proc _g_xor (c:W32.t ArrayN.t, a:W32.t ArrayN.t, b:W32.t ArrayN.t) : 
  W32.t ArrayN.t = {
    var inc:int;
    var i:int;
    var x:W32.t;
    var y:W32.t;
    var  _0:W32.t;
    var  _1:W32.t;
    a <- a;
    b <- b;
    c <- c;
    inc <- (order + 1);
    i <- 0;
    while ((i < inc)) {
      x <- a.[i];
      y <- b.[i];
      x <- (x `^` y);
      c.[i] <- x;
       _0 <- (x `^` x);
       _1 <- (y `^` y);
      i <- (i + 1);
    }
    return c;
  }
  proc _g_xor_inplace (a:W32.t ArrayN.t, b:W32.t ArrayN.t) : W32.t ArrayN.t = {
    var inc:int;
    var i:int;
    var x:W32.t;
    var y:W32.t;
    var  _0:W32.t;
    var  _1:W32.t;
    a <- a;
    b <- b;
    inc <- (order + 1);
    i <- 0;
    while ((i < inc)) {
      x <- a.[i];
      y <- b.[i];
      x <- (x `^` y);
      a.[i] <- x;
       _0 <- (x `^` x);
       _1 <- (y `^` y);
      i <- (i + 1);
    }
    return a;
  }
  proc _g_not (y:W32.t ArrayN.t, x:W32.t ArrayN.t) : W32.t ArrayN.t = {
    var inc:int;
    var s:W32.t;
    var i:int;
    var  _0:W32.t;
    var  _1:W32.t;
    y <- y;
    x <- x;
    s <- x.[0];
    s <- (s `^` (W32.of_int (- 1)));
    y.[0] <- s;
     _0 <- (s `^` s);
    inc <- (order + 1);
    i <- 1;
    while ((i < inc)) {
      s <- x.[i];
      y.[i] <- s;
       _1 <- (s `^` s);
      i <- (i + 1);
    }
    return y;
  }
  proc _g_not_inplace (x:W32.t ArrayN.t) : W32.t ArrayN.t = {
    var s:W32.t;
    var  _0:W32.t;
    x <- x;
    s <- x.[0];
    s <- (s `^` (W32.of_int (- 1)));
    x.[0] <- s;
     _0 <- (s `^` s);
    return x;
  }
  proc _g_shl (y:W32.t ArrayN.t, x:W32.t ArrayN.t, a:W32.t) : W32.t ArrayN.t = {
    var inc:int;
    var i:int;
    var s:W32.t;
    var  _0:W32.t;
    inc <- (order + 1);
    i <- 0;
    while ((i < inc)) {
      s <- x.[i];
      s <- (s `<<` (truncateu8 a));
      y.[i] <- s;
      s <- (s `^` s);
      i <- (i + 1);
    }
     _0 <- (s `<<` (truncateu8 a));
    return y;
  }
  proc _g_shl_inplace (x:W32.t ArrayN.t, a:W32.t) : W32.t ArrayN.t = {
    var inc:int;
    var i:int;
    var s:W32.t;
    var  _0:W32.t;
    inc <- (order + 1);
    i <- 0;
    while ((i < inc)) {
      s <- x.[i];
      s <- (s `<<` (truncateu8 a));
      x.[i] <- s;
      s <- (s `^` s);
      i <- (i + 1);
    }
     _0 <- (s `<<` (truncateu8 a));
    return x;
  }
  proc _g_shr (y:W32.t ArrayN.t, x:W32.t ArrayN.t, a:W32.t) : W32.t ArrayN.t = {
    var inc:int;
    var i:int;
    var s:W32.t;
    var  _0:W32.t;
    inc <- (order + 1);
    i <- 0;
    while ((i < inc)) {
      s <- x.[i];
      s <- (s `>>` (truncateu8 a));
      y.[i] <- s;
      s <- (s `^` s);
      i <- (i + 1);
    }
     _0 <- (s `<<` (truncateu8 a));
    return y;
  }
  proc _g_shr_inplace (x:W32.t ArrayN.t, a:W32.t) : W32.t ArrayN.t = {
    var inc:int;
    var i:int;
    var s:W32.t;
    var  _0:W32.t;
    inc <- (order + 1);
    i <- 0;
    while ((i < inc)) {
      s <- x.[i];
      s <- (s `>>` (truncateu8 a));
      x.[i] <- s;
      s <- (s `^` s);
      i <- (i + 1);
    }
     _0 <- (s `<<` (truncateu8 a));
    return x;
  }
  proc _g_rolC (y:W32.t ArrayN.t, x:W32.t ArrayN.t, a:int) : W32.t ArrayN.t = {
    var inc:int;
    var i:int;
    var s:W32.t;
    var  _0:W32.t;
    inc <- (order + 1);
    i <- 0;
    while ((i < inc)) {
      s <- x.[i];
      s <- (s `|<<|` (W8.of_int a));
      y.[i] <- s;
      s <- (s `^` s);
      i <- (i + 1);
    }
     _0 <- (s `|<<|` (W8.of_int a));
    return y;
  }
  proc rol64 (res_hi:W32.t ArrayN.t, res_lo:W32.t ArrayN.t,
              x_hi:W32.t ArrayN.t, x_lo:W32.t ArrayN.t, a:int) : 
  W32.t ArrayN.t * W32.t ArrayN.t = {
    var inc:int;
    var b:int;
    var shift:int;
    var i:int;
    var lo:W32.t;
    var hi:W32.t;
    var tmp:W32.t;
    var umsb:W32.t;
    var lmsb:W32.t;
    var  _0:W32.t;
    var  _1:W32.t;
    var  _2:W32.t;
    var  _3:W32.t;
    var  _4:W32.t;
    b <- (a %% 64);
    shift <- (b %% 32);
    inc <- (order + 1);
    i <- 0;
    while ((i < inc)) {
      lo <- x_hi.[i];
      hi <- x_lo.[i];
      if ((32 < b)) {
        tmp <- lo;
        lo <- hi;
        hi <- tmp;
         _0 <- (tmp `^` tmp);
      } else {
        
      }
      umsb <- hi;
      umsb <- (umsb `>>` (W8.of_int (32 - shift)));
      lmsb <- lo;
      lmsb <- (lmsb `>>` (W8.of_int (32 - shift)));
      hi <- (hi `<<` (W8.of_int shift));
      lo <- (lo `<<` (W8.of_int shift));
      hi <- (hi `^` lmsb);
       _1 <- (lmsb `^` lmsb);
      lo <- (lo `^` umsb);
       _2 <- (umsb `^` umsb);
      res_hi.[i] <- lo;
      res_lo.[i] <- hi;
       _3 <- (lo `^` lo);
      hi <- (hi `^` hi);
      i <- (i + 1);
    }
     _4 <- (hi `<<` (W8.of_int 1));
    return (res_hi, res_lo);
  }
  proc rol64_1 (res_hi:W32.t ArrayN.t, res_lo:W32.t ArrayN.t,
                x_hi:W32.t ArrayN.t, x_lo:W32.t ArrayN.t) : W32.t ArrayN.t *
                                                                  W32.t ArrayN.t = {
    
    (res_hi, res_lo) <@ rol64 (res_hi, res_lo, x_hi, x_lo, 1);
    return (res_hi, res_lo);
  }
  proc _g_and (c:W32.t ArrayN.t, a:W32.t ArrayN.t, b:W32.t ArrayN.t,
               randomness:W32.t ArrayRandAnd.t) : W32.t ArrayN.t = {
    var inc:int;
    var inc_0:int;
    var rand_counter:int;
    var i:int;
    var x:W32.t;
    var y:W32.t;
    var rand:W32.t;
    var j:int;
    var z:W32.t;
    var  _0:W32.t;
    var  _1:W32.t;
    var  _2:W32.t;
    var  _3:W32.t;
    var  _4:W32.t;
    var  _5:W32.t;
    var  _6:W32.t;
    var  _7:W32.t;
    c <- c;
    a <- a;
    b <- b;
    rand_counter <- 0;
    inc <- (order + 1);
    i <- 0;
    while ((i < inc)) {
      x <- a.[i];
      y <- b.[i];
      x <- (x `&` y);
      c.[i] <- x;
       _0 <- (x `^` x);
       _1 <- (y `^` y);
      i <- (i + 1);
    }
    inc <- (order + 1);
    i <- 0;
    while ((i < inc)) {
      inc_0 <- (order + 1);
      j <- (i + 1);
      while ((j < inc_0)) {
        rand <- randomness.[rand_counter];
        rand_counter <- (rand_counter + 1);
        x <- c.[i];
        x <- (x `^` rand);
        c.[i] <- x;
         _2 <- (x `^` x);
        x <- a.[i];
        y <- b.[j];
        x <- (x `&` y);
        x <- (x `^` rand);
         _3 <- (rand `^` rand);
         _4 <- (y `^` y);
        y <- a.[j];
        z <- b.[i];
        y <- (y `&` z);
         _5 <- (z `^` z);
        x <- (x `^` y);
        y <- (y `^` y);
        y <- c.[j];
        x <- (x `^` y);
         _6 <- (y `^` y);
        c.[j] <- x;
         _7 <- (x `^` x);
        j <- (j + 1);
      }
      i <- (i + 1);
    }
    c <- c;
    return c;
  }
  proc _g_ref (c:W32.t ArrayN.t, a:W32.t ArrayN.t,
               randomness:W32.t ArrayRandAnd.t) : W32.t ArrayN.t = {
    var inc:int;
    var x:W32.t;
    var one:W32.t ArrayN.t;
    var i:int;
    var onep:W32.t ArrayN.t;
    one <- witness;
    onep <- witness;
    x <- (W32.of_int (- 1));
    one.[0] <- x;
    x <- (W32.of_int 0);
    inc <- (order + 1);
    i <- 1;
    while ((i < inc)) {
      one.[i] <- x;
      i <- (i + 1);
    }
    onep <- one;
    c <@ _g_and (c, a, onep, randomness);
    return c;
  }
  proc _g_share (res_0:W32.t ArrayN.t, x:W32.t,
                 randomness:W32.t ArrayPN.t) : W32.t ArrayN.t = {
    var inc:int;
    var i:int;
    var r:W32.t;
    x <- x;
    inc <- ((order + 1) - 1);
    i <- 0;
    while ((i < inc)) {
      r <- randomness.[i];
      res_0.[i] <- r;
      x <- (x `^` r);
      i <- (i + 1);
    }
    res_0.[((order + 1) - 1)] <- x;
    return res_0;
  }
  proc _g_reconstruct (x:W32.t ArrayN.t) : W32.t = {
    var inc:int;
    var s:W32.t;
    var i:int;
    var a:W32.t;
    s <- x.[0];
    inc <- (order + 1);
    i <- 1;
    while ((i < inc)) {
      a <- x.[i];
      s <- (s `^` a);
      i <- (i + 1);
    }
    return s;
  }
  proc lm_share_derand (res_0:W32.t ArrayN.t, x:W32.t,
                        randomness:W32.t ArrayPN.t) : W32.t ArrayN.t = {
    
    res_0 <@ _g_share (res_0, x, randomness);
    return res_0;
  }
  proc lm_reconstruct (x:W32.t ArrayN.t) : W32.t = {
    var res_0:W32.t;
    res_0 <@ _g_reconstruct (x);
    return res_0;
  }
  proc lm_get_order () : W32.t = {
    var r:W32.t;
    r <- (W32.of_int order);
    return r;
  }
  proc lm_xor (c:W32.t ArrayN.t, a:W32.t ArrayN.t, b:W32.t ArrayN.t) : 
  W32.t ArrayN.t = {
    
    c <@ _g_xor (c, a, b);
    return c;
  }
  proc lm_xor_inplace (a:W32.t ArrayN.t, b:W32.t ArrayN.t) : W32.t ArrayN.t = {
    
    a <@ _g_xor_inplace (a, b);
    return a;
  }
  proc lm_not (y:W32.t ArrayN.t, x:W32.t ArrayN.t) : W32.t ArrayN.t = {
    
    y <@ _g_not (y, x);
    return y;
  }
  proc lm_not_inplace (x:W32.t ArrayN.t) : W32.t ArrayN.t = {
    
    x <@ _g_not_inplace (x);
    return x;
  }
  proc lm_shl (y:W32.t ArrayN.t, x:W32.t ArrayN.t, a:W32.t) : W32.t ArrayN.t = {
    
    y <@ _g_shl (y, x, a);
    return y;
  }
  proc lm_shl_inplace (x:W32.t ArrayN.t, a:W32.t) : W32.t ArrayN.t = {
    
    x <@ _g_shl_inplace (x, a);
    return x;
  }
  proc lm_shr (y:W32.t ArrayN.t, x:W32.t ArrayN.t, a:W32.t) : W32.t ArrayN.t = {
    
    y <@ _g_shr (y, x, a);
    return y;
  }
  proc lm_shr_inplace (x:W32.t ArrayN.t, a:W32.t) : W32.t ArrayN.t = {
    
    x <@ _g_shr_inplace (x, a);
    return x;
  }
  proc lm_and_derand (c:W32.t ArrayN.t, a:W32.t ArrayN.t,
                      b:W32.t ArrayN.t, randomness:W32.t ArrayRandAnd.t) : 
  W32.t ArrayN.t = {
    
    c <@ _g_and (c, a, b, randomness);
    return c;
  }
  proc lm_ref_derand (c:W32.t ArrayN.t, a:W32.t ArrayN.t,
                      randomness:W32.t ArrayRandAnd.t) : W32.t ArrayN.t = {
    
    c <@ _g_ref (c, a, randomness);
    return c;
  }
  proc lm_rol64_1 (res_hi:W32.t ArrayN.t, res_lo:W32.t ArrayN.t,
                   x_hi:W32.t ArrayN.t, x_lo:W32.t ArrayN.t) : 
  W32.t ArrayN.t * W32.t ArrayN.t = {
    
    (res_hi, res_lo) <@ rol64_1 (res_hi, res_lo, x_hi, x_lo);
    return (res_hi, res_lo);
  }
}.


hoare rec_correct (s: sharing) :
  MSpec._g_reconstruct : x = s ==> rec s = res.
proof.
  proc.

  while (inc = order + 1 /\ 0 < i <= order + 1 /\ s{!hr} = rec_l (take i (to_list x))).
  + auto => /> &hr ge0i ileordS iltordS.
    rewrite rec_l_takeS //; smt().
  auto.
  progress.
  + smt(ge0_order).
  + rewrite rec_l_take1 -get_to_list. apply nth_change_dfl. rewrite size_to_list. smt(ge0_order').
  + have ->: i0 = size (to_list x {hr}) by rewrite size_to_list; smt().
    by rewrite take_size.
qed.

hoare share_rec_inv (v: W32.t):
  MSpec._g_share : x = v ==> rec res = v.
proof.
  proc.
  auto.
  while (inc = order /\ 0 <= i <= order /\ x = v `^` rec_l (take i (to_list res_0))).
    inline *; auto.
    progress; first 2 smt().
    rewrite #ring xorwK_s //.
    rewrite rec_l_takeS // get_setE //= 1:#smt:() #ring xorwK_s //.
    congr. apply (eq_from_nth witness); rewrite !size_take ?size_to_list //.
    progress. rewrite !nth_take //; first 2 smt().
    rewrite !get_to_list get_setE #smt:().
  auto.
  move=> &hr ->. do split.
  + rewrite take0 rec_l_nil #ring.
  + move=>i' s v' hi' [_ [i'b ->]].
    rewrite /rec {1}/ArrayN.to_list mkseqS // rec_l_rcons //= get_setE 1:#smt:() //=.
    rewrite /recpart #ring xorwK_s //.
    congr.
    apply (eq_from_nth witness); rewrite size_take 2:!size_mkseq; first 3 smt().
    rewrite lez_maxr 2:iftrue; first 2 smt().
    progress.
    rewrite (nth_map witness) 1:#smt:(size_iota) nth_iota 1:#smt:().
    rewrite get_setE 2:nth_take 4:iffalse //; smt().
qed.

hoare xor_correct (sa sb : sharing):
  MSpec._g_xor : a = sa /\ b = sb ==> rec res = rec sa `^` rec sb.
proof.
  proc.
  auto.
  while (inc = order + 1 /\ 0 <= i <= order + 1 /\ forall i', 0 <= i' < i => c.[i'] = a.[i'] `^` b.[i']).
    auto.
    progress; first 2 smt().
    rewrite get_setE //.
    case (i' = i{hr}); smt().
  auto.
  progress.
  + smt(ge0_order).
  + smt().
  + smt(rec_linear).
qed.

op partial_crossterm r (a b: sharing) i i' = (a.[i'] `&` b.[i'])
        `^` rec_l (map (fun __prev => r __prev i' `^` (a.[__prev] `&` b.[i']) `^` (a.[i'] `&` b.[__prev])) (range 0 i)).


lemma crossterm_map_ge_index r a b i i' x:
    0 <= i < i' <= order + 1 => crossterm r a b i = crossterm r.[i' <- x] a b i.
proof.
  move => [] []  ge0_i i_le_i' i'_lt_orderS.
  rewrite /crossterm.
  have -> : r.[i' <- x] i = r i by rewrite /"_.[_<-_]" iffalse // #smt:().
  rewrite #ring xorwK_s //.
  congr. apply (eq_from_nth witness); rewrite !size_map !size_range !lez_maxr //.
  move=>el hel. rewrite !(nth_map witness) ?nth_range ?size_range ?lez_maxr //=.
  rewrite /"_.[_<-_]" iffalse. smt(). ring.
qed.

lemma partial_crossterm_map_ge_index r a b i i' x n:
    0 <= i <= n <= order + 1 => partial_crossterm r a b i i' = partial_crossterm r.[n <- x] a b i i'.
proof.
  move => [] []  ge0_i i_le_i' i'_lt_orderS.
  rewrite /partial_crossterm //=.
  rewrite #ring xorwK_s //.
  congr. apply (eq_from_nth witness); rewrite !size_map !size_range !lez_maxr //.
  move=>el hel. rewrite !(nth_map witness) ?nth_range ?size_range ?lez_maxr //=.
  rewrite /"_.[_<-_]" iffalse. smt(). ring.
qed.

hoare and_correct (sa sb : sharing):
  MSpec._g_and : a = sa /\ b = sb ==> rec res = rec sa `&` rec sb.
proof.
  proc.
  auto.
  while (
    inc = order + 1 /\
    0 <= i <= order + 1 /\ exists r, forall i',
      (0 <= i' < i => c.[i'] = crossterm r a b i')
      /\ (i <= i' < order + 1 => c.[i'] = partial_crossterm r a b i i')
  ).

  (* outer invariant preserved: *)
  auto.
  while (
    inc_0 = order + 1 /\
    0 <= i < order + 1 /\ i < j <= order + 1 /\ exists r, forall i',
      (0 <= i' < i => c.[i'] = crossterm r a b i')
      /\ (i <= i' < order + 1 => c.[i'] = partial_crossterm r a b i i'
        `^` if i = i' (* this is what happens in this iteration *)
          then rec_l (map (r i') (range (i'+1) j)) (* we add: c_i += r_ij *)
          else W32.zerow
        `^` if i' < j (* we add to all c_j (i.e. i'=j) r_ji *)
          then r i i' `^` (a.[i] `&` b.[i']) `^` (a.[i'] `&` b.[i])
          else W32.zerow
)
  ).
  (* inner invariant preserved by loop: *)
  inline *. auto.
  move=> &hr [] //= [] ? [iB [] jB [] r HInv jBound_in_loop] //=.
  do split; first 5 smt().

  (* Loop invariant is witnessed by some function that maps to the rand_ij on inputs i and j. *)
  exists r.[i{hr} <- (r i{hr}).[j{hr} <- randomness{hr}.[rand_counter{hr}]]] => i'.
  have [H_lti H_gti] := HInv i'.
  clear HInv.
  split => i'b.
  - rewrite !get_setE //=. smt(). rewrite iffalse 2:iffalse; first 2 smt().
    rewrite -crossterm_map_ge_index; smt().
  - rewrite !get_setE //= 2:-partial_crossterm_map_ge_index; first 2 smt().
    subst.
    case (i' = j{hr})=>i'_j //=.
    + subst. rewrite iffalse 2:iffalse; first 2 smt().
      by rewrite H_gti //= iffalse 2:iftrue 3:#ring; first 2 smt().
    + case (i' = i{hr})=>Hi'i //>.
      * subst. rewrite iftrue // H_gti //= #ring. rewrite rangeSr. smt().
        rewrite map_rcons rec_l_rcons /"_.[_<-_]" //= #ring xorwK_s //.
        congr. apply (eq_from_nth witness); rewrite !size_map !size_range lez_maxr; first 3 smt().
        move=>i ib. rewrite !(nth_map witness) ?(nth_range witness) ?size_range ?lez_maxr //=; first 2 smt().
        rewrite nth_range //. smt().
      * rewrite iffalse 1:eq_sym //. case (i' < j{hr} + 1)=>?//=; first smt().
        rewrite H_gti //= iffalse 2:#ring; smt().
  (* inner inner invariant initially follows from outer and inner invariant preserves outer invariant *)
  auto.
  move => &hr [[] ? [] iBound [] r Inv_outer iBound_in_loop].
  do split; first 4 smt(). (* initial bounds for i, j immediately follow from outer bounds *)
  + (* inner invariant is implied by outer intially *)
    exists r => i'.
    have [Iol Ior] := Inv_outer i'.
    split=>i'B.
    - by apply Iol.
    - rewrite (Ior i'B) #ring.
      case (i{hr} = i') => Hcase.
      + rewrite Hcase range_geq // xorwK.
      + rewrite iffalse; smt().
  + (* inner invariant preserves outer invariant *)
    move=> c_after j jAfterLoop [? [] L__Bi [] L__Bj [] L__r LI].
    do split; first 3 smt(). (* bounds are preserved *)
    exists L__r => i'.
    have [LI'l LI'r] := LI i'.
    split=>i'B.
    - case (i' = i{hr}) => Hi'i />.
      + rewrite LI'r; first smt().
        rewrite iftrue; first smt().
        have -> : j = order + 1 by smt().
        rewrite /crossterm /partial_crossterm #ring //= xorwK_s //.
        congr.
        apply (eq_from_nth witness).
        + by smt(size_map size_range).
        rewrite !size_map Hi'i.
        move=>i iB.
        rewrite !(nth_map witness) //= #ring.
      + by apply LI'l; first smt().
    - rewrite /partial_crossterm LI'r 2:iffalse 3:iftrue 4:rangeSr; first 4 smt().
      rewrite map_rcons rec_l_rcons //= #ring.

  (* initialization c_i = a_i * b_i *)
  auto.
  while (inc = order + 1 /\ 0 <= i <= order + 1 /\ forall i', 0 <= i' < i => c.[i'] = a.[i'] `&` b.[i']); auto.
  - progress.
    + smt().
    + smt().
    + rewrite get_set_if; smt().
  - progress.
    + smt(ge0_order).
    + smt().
    + smt().
    + rewrite /partial_crossterm /crossterm range_geq //=; smt().
    + apply isw_and_correct.
      rewrite /isw_and_crossterms.
      exists r=> i' i'B.
      rewrite H6; smt().
qed.

lemma of_int_minus_one : W32.of_int (-1) = W32.onew.
proof.
  simplify.
  rewrite /onew.
  done.
qed.

hoare refresh_correct (s : sharing)
  : MSpec._g_ref : a = s ==> rec res = rec s.
proof.
  proc.
  auto. sp.

  (* while (oneS.[0] = one /\ forall i', 0 < i' < i => oneS.[i] = zero /\ x = zero /\ 1 <= i <= order + 1). *)
  auto.
  seq 2 : (rec onep = onew /\ a = s); first last.
  - ecall (and_correct a onep).
    skip. move=>/> ? -> r ->.
    by rewrite andw1.
  - wp.
    while (
         inc = order + 1
      /\ one.[0] = onew
      /\ (forall i', 0 < i' < i => one.[i'] = zero)
      /\ x = zero
      /\ 1 <= i <= order + 1).
    auto.
    progress; last 2 smt(). (* i's bounds are trivial *)
    - by rewrite get_set_if iffalse; first smt(). (* oneS[0] untouched *)
    - rewrite get_set_if; smt(). (* rest zeored out *)
  skip.
  rewrite of_int_minus_one.
  progress.
  + rewrite get_set_if iftrue; smt(ge0_order).
  + rewrite get_set_if iffalse; smt().
  + smt(ge0_order).
  + rewrite /rec /rec_l /to_list.
    rewrite mkseqSr //= H0 #ring.
    move: H H0 H1 H2. have : 0 <= order by done. move:order.
    apply intind =>/>.
    + by rewrite mkseq0.
    + move=>i1 i1B iH H H0 H1 H2.
      rewrite mkseqS // foldr_rcons /(\o) //= H1 ?iH; smt().
qed.

abstract theory LinearGadget.
  op f : { word -> word | linear f } as linear_f.

  module Spec = {
    proc sharewise (c:sharing, a:sharing) : sharing = {
      var i:int;
      var x:W32.t;
      var y:W32.t;
      a <- a;
      c <- c;
      i <- 0;
      while ((i < order + 1)) {
        x <- a.[i];
        y <- f x;
        c.[i] <- y;
        i <- (i + 1);
      }
      c <- c;
      return c;
    }
  }.

  hoare correctness (s : sharing) :
    Spec.sharewise : a = s ==> rec res = f (rec s).
  proof.
    proc. auto.
    while(0 <= i <= order + 1 /\ forall i', 0 <= i' < i => c.[i'] = f (a.[i'])).
    auto.
    move=> &hr [] [] [] //= ? ? ih ?. progress; first 2 smt().
    rewrite get_setE //. case (i' = i{hr})=>?. by subst. by rewrite ih 1:#smt:().
    auto. progress. smt(ge0_order). rewrite !get_out; smt().
    rewrite linear_elementwise. exact linear_f.
    rewrite /rec. congr. apply (eq_from_nth witness); rewrite !size_to_list //.
    move=>??. rewrite map_to_list get_to_list (nth_map witness) /= ?size_to_list; smt().
  qed.
end LinearGadget.
